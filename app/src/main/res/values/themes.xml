<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Kylie Mail is dark only; the window matches the bg-primary color so nothing flashes before Compose draws. -->
    <style name="Theme.KylieMail" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
</resources>
